# Salin berkas ini menjadi .env lalu sesuaikan kunci API jika menggunakan mode live
API_MODE=mock
API_PROVIDER_PRESET=sela-default

# Pengenalan suara bawaan browser
ASR_PROVIDER=mock
ASR_MODEL=browser-native

# Konfigurasi LLM (Groq / OpenAI compatible)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# Konfigurasi suara
TTS_PROVIDER=mock
TTS_LANGUAGE_MODE=auto
TTS_SPEED=1

PRONUNCIATION_PROVIDER=rule

PORT=5174
VITE_BUSINESS_API_URL=http://127.0.0.1:5174
