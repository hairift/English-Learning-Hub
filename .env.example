# =============================================================================
# Sela Tutor English — Environment Configuration (English + Bahasa Indonesia)
# Copy this file to `.env.local` (or `.env`) and fill in your own keys.
# Salin berkas ini menjadi `.env.local` (atau `.env`) lalu isi kunci API Anda.
# =============================================================================

# Runtime mode / mode runtime:
#   mock -> no paid API needed, safe for demos / tanpa kunci API berbayar.
#   live -> call real providers below / memanggil provider sungguhan.
API_MODE=mock

# Provider presets / preset provider:
#   sela-default     -> Groq LLM + Supertonic TTS (recommended / direkomendasikan)
#   groq-elevenlabs  -> Groq LLM + ElevenLabs TTS
#   china-qwen       -> Qwen/Bailian ASR + LLM + TTS
#   global-mixed     -> AssemblyAI + OpenAI-compatible LLM + Cartesia
#   custom           -> configure everything manually / atur manual
API_PROVIDER_PRESET=sela-default

# ---------------------------------------------------------------------------
# ASR (speech recognition / pengenalan suara)
# "mock" = use the browser's built-in Web Speech API (no key needed).
# ---------------------------------------------------------------------------
ASR_PROVIDER=mock
ASR_MODEL=browser-native

# ---------------------------------------------------------------------------
# LLM (the tutor's brain / otak tutor)
# Groq is the default because it is fast and cheap.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# ---------------------------------------------------------------------------
# TTS (the tutor's voice / suara tutor) — Supertonic is the default.
# Supertonic is an on-device TTS with 31 languages, including `id` and `en`.
# Run it with: cd tts_service && uvicorn server:app --port 7861
# ---------------------------------------------------------------------------
TTS_PROVIDER=supertonic
TTS_MODEL=supertonic-3
# F1-F5 = female voices, M1-M5 = male voices. F1 = default Indonesian female.
TTS_VOICE_ID=F1
# "auto" detects Indonesian/English per sentence automatically.
TTS_LANGUAGE_MODE=auto
# Speech speed 0.7 - 2.0 / kecepatan bicara.
TTS_SPEED=1
# Quality 5 - 12 / kualitas.
TTS_STEPS=8
TTS_SERVICE_URL=http://127.0.0.1:7861

# Pronunciation assessment / penilaian pengucapan.
PRONUNCIATION_PROVIDER=rule

# ---------------------------------------------------------------------------
# Optional alternative TTS providers / provider TTS alternatif
# ---------------------------------------------------------------------------
# TTS_PROVIDER=elevenlabs
# TTS_API_KEY=
# TTS_MODEL=eleven_multilingual_v2
# TTS_VOICE_ID=

# TTS_PROVIDER=cartesia
# TTS_API_KEY=
# TTS_MODEL=sonic-3.5
# TTS_VERSION=2026-03-01
# TTS_VOICE_ID=

# TTS_PROVIDER=qwen-tts
# TTS_API_KEY=

# ---------------------------------------------------------------------------
# Optional alternative ASR providers / provider ASR alternatif
# ---------------------------------------------------------------------------
# ASR_PROVIDER=assemblyai
# ASR_MODEL=universal-3-pro
# ASSEMBLYAI_API_KEY=
# ASR_API_KEY=

# ASR_PROVIDER=deepgram
# ASR_MODEL=nova-3
# DEEPGRAM_API_KEY=

# ASR_PROVIDER=qwen-asr
# ASR_MODEL=qwen3-asr-flash
# DASHSCOPE_API_KEY=

# ---------------------------------------------------------------------------
# Optional alternative LLM providers / provider LLM alternatif
# ---------------------------------------------------------------------------
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# DASHSCOPE_API_KEY=

# LLM_PROVIDER=doubao
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=

# LLM_PROVIDER=kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_API_KEY=

# LLM_PROVIDER=custom-openai-compatible
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL=your-model
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Ports / port
# ---------------------------------------------------------------------------
PORT=5174

# Browser -> Pipecat voice agent bridge (optional real-time voice).
VITE_PIPECAT_BASE_URL=http://127.0.0.1:7860
VITE_BUSINESS_API_URL=http://127.0.0.1:5174
VITE_TTS_SERVICE_URL=http://127.0.0.1:7861
